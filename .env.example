# Port the web server listens on
PORT=3000
# Where the SQLite database and generated secrets live (back this folder up!)
DATA_DIR=./data
# Optional: set explicitly in production. If omitted they are generated once into DATA_DIR/.secrets.json
SESSION_SECRET=
AUDIT_SECRET=
# Set to true when served over HTTPS (behind a reverse proxy)
SECURE_COOKIES=false
# Business timezone used for "today", due dates and scheduling
TZ_NAME=Asia/Colombo
